# WasteLens configuration — copy to .env and fill in secrets. Never commit .env.

# --- Database ---
POSTGRES_USER=wastelens
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wastelens
DATABASE_URL=postgresql+psycopg://wastelens:change-me@db:5432/wastelens

# --- Redis / queue ---
REDIS_URL=redis://redis:6379/0

# --- Object storage ---
# Local/Docker: MinIO, an S3-compatible service, needs an explicit endpoint.
# Real AWS S3: leave S3_ENDPOINT_URL and S3_PUBLIC_ENDPOINT_URL BOTH unset
# (delete the lines, don't set them to empty strings) — boto3 resolves the
# correct regional S3 endpoint on its own from S3_REGION, and AWS's
# presigned URLs are already publicly reachable without a separate address.
S3_ENDPOINT_URL=http://minio:9000
# Address the browser (not the API container) can reach MinIO at, used only
# for signing image URLs handed to the frontend (Phase 3 review page).
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=wastelens
S3_SECRET_KEY=change-me
S3_BUCKET_CAPTURES=tray-captures
S3_REGION=us-east-1

# --- Database backups (Phase 8) ---
# Nightly pg_dump uploaded to S3 under backups/postgres/. Leave unset to
# reuse S3_BUCKET_CAPTURES (the existing IAM policy already covers the
# whole bucket); set only to isolate backups in a separate bucket.
S3_BUCKET_BACKUPS=
BACKUP_RETENTION_DAYS=30

# --- Auth ---
JWT_SECRET=change-me-64-random-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Bootstrap admin (created by seed script if no admin exists)
BOOTSTRAP_ADMIN_EMAIL=admin@wastelens.io
BOOTSTRAP_ADMIN_PASSWORD=change-me

# --- Vision / CV pipeline ---
# Which VisionProvider implementation the worker uses: "nvidia" or "anthropic"
VISION_PROVIDER=nvidia

# NVIDIA NIM (default) — key from build.nvidia.com (nvapi-...). NEVER commit the real key.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct

# Anthropic (optional alternative, used when VISION_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-4-6

VISION_MAX_TOKENS=4096
VISION_TIMEOUT_SECONDS=180
CONFIDENCE_REVIEW_THRESHOLD=0.75
BRAND_MATCH_THRESHOLD=85
CV_DAILY_CALL_CAP=1000

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
API_CORS_ORIGINS=["http://localhost:5173"]

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
